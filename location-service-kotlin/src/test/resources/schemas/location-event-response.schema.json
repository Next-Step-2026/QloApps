{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LocationEventResponseSchema",
  "type": "object",
  "required": [
    "correlation_id",
    "hotel_id",
    "distance_meters",
    "current_state",
    "transition",
    "alert_triggered",
    "message"
  ],
  "properties": {
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "hotel_id": {
      "type": "string",
      "minLength": 1
    },
    "distance_meters": {
      "type": "number",
      "minimum": 0.0
    },
    "current_state": {
      "type": "string",
      "enum": ["inside", "outside"]
    },
    "transition": {
      "type": "string",
      "enum": ["ENTERED", "EXITED", "NO_CHANGE"]
    },
    "alert_triggered": {
      "type": "boolean"
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
