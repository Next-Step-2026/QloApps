{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProblemDetailsSchema",
  "type": "object",
  "required": ["type", "title", "status", "detail", "instance", "code"],
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^urn:problem-type:[a-z-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string",
      "pattern": "^/.*"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    }
  },
  "additionalProperties": false
}
